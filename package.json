{
  "name": "nconnect",
  "version": "0.22.3",
  "private": true,
  "description": "Use Nebius Token Factory models in Claude Code, Codex, OpenCode, Pi, Prime Agent, Hermes, DeepSeek Harness, and Grok Build",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "build:bundle": "bash scripts/build-bundle.sh",
    "build:site": "pnpm build:bundle && pnpm --dir site exec convex codegen --typecheck disable && pnpm --filter @nconnect/site build",
    "build:site:preview": "pnpm build:bundle && pnpm --filter @nconnect/site build",
    "bump-version": "bash scripts/bump-version.sh",
    "dev": "pnpm -F @nconnect/cli dev",
    "dev:site": "pnpm --filter @nconnect/site dev",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "hooks:install": "lefthook install",
    "test": "pnpm -F @nconnect/tests test",
    "test:offline": "pnpm --filter @nconnect/cli... build && pnpm -F @nconnect/tests test:offline",
    "bench:proxy": "pnpm -F @nconnect/tests bench:proxy",
    "capture:proxy-fixtures": "pnpm -F @nconnect/tests capture:proxy-fixtures",
    "watch": "pnpm dev",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "lefthook": "2.1.9",
    "oxfmt": "0.57.0",
    "turbo": "^2.10.1",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@11.9.0"
}

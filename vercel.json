{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "tanstack-start",
  "buildCommand": "bash scripts/vercel-build.sh",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/install.sh",
      "headers": [
        {
          "key": "content-type",
          "value": "text/x-shellscript; charset=utf-8"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "content-type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/latest.json",
      "headers": [
        {
          "key": "content-type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "cache-control",
          "value": "public, max-age=60, must-revalidate"
        }
      ]
    },
    {
      "source": "/nconnect.js",
      "headers": [
        {
          "key": "content-type",
          "value": "application/javascript; charset=utf-8"
        },
        {
          "key": "cache-control",
          "value": "public, max-age=60, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/docs/tutorials/qwen-3-5-opencode",
      "destination": "/docs/tutorials/qwen-3-8-opencode",
      "permanent": true
    },
    {
      "source": "/docs/tutorials/kimi-k2-7-code-unreal-agent",
      "destination": "/docs/tutorials/kimi-k3-1-pro-unreal-agent",
      "permanent": true
    },
    {
      "source": "/((?!latest\\.json$|nconnect\\.js$|nebiusrelay\\.js$|install\\.sh$|llms\\.txt$).*)",
      "has": [
        {
          "type": "host",
          "value": "nebius-tf-relay.vercel.app"
        }
      ],
      "destination": "https://nconnect.sh/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/nebiusrelay.js",
      "destination": "/nconnect.js"
    }
  ]
}
